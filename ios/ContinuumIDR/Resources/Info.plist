<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Continuum IDR</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Continuum IDR requires location to acquire initial GNSS coordinates and benchmark dead reckoning accuracy.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Continuum IDR tracks vehicular dead reckoning continuously during tunnel and flyover outages in the background.</string>
	<key>NSMotionUsageDescription</key>
	<string>Continuum IDR uses the device accelerometer and gyroscope for 10 Hz real-time dead-reckoning navigation fallback.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Continuum IDR uses Bluetooth Low Energy for peer-to-peer V2V cooperative hazard alerts without cellular data.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Continuum IDR broadcasts anonymous hazard beacons to nearby vehicles over BLE.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
</dict>
</plist>
